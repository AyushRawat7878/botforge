# ---- Security ----
# Change this to any long random string before deploying.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database ----
# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/chatbots
DATABASE_URL=sqlite:///./chatbots.db

# ---- LLM (any OpenAI-compatible API) ----
# Leave LLM_API_KEY empty to run in demo mode (canned replies, no API calls).
#
# Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1
#                     LLM_MODEL=openai/gpt-oss-120b   (or openai/gpt-oss-20b for faster replies)
# Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                     LLM_MODEL=gemini-2.0-flash
# OpenAI:             LLM_BASE_URL=https://api.openai.com/v1
#                     LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# How many previous messages the bot remembers in each conversation.
MEMORY_MESSAGES=20

# ---- Images ----
# Image replies are generated with Pollinations.ai (free, no key needed).
IMAGE_BASE_URL=https://image.pollinations.ai/prompt

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173
